{
  "name": "@slicr/event-sourcing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./sqlite": {
      "types": "./src/sqliteSpecEventStore.ts",
      "import": "./src/sqliteSpecEventStore.ts"
    },
    "./ndjson": {
      "types": "./src/ndjsonSpecEventStore.ts",
      "import": "./src/ndjsonSpecEventStore.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts"
    },
    "./atoms": {
      "types": "./src/atoms/index.ts",
      "import": "./src/atoms/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:llm": "vitest run --reporter=vitest-llm-reporter",
    "test:mutation": "stryker run",
    "test:mutation:vitest": "vitest run --config vitest.config.ts && vitest run --config vitest.browser.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "lint": "eslint .",
    "watch": "vitest run --watch --reporter=default --reporter=vitest-lib/cliReporter"
  },
  "dependencies": {
    "vitest-lib": "0.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.4",
    "@vitest/browser-playwright": "^4.0.18",
    "eslint": "^9.39.4",
    "playwright": "^1.58.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.0.18",
    "vitest-llm-reporter": "^1.2.2"
  }
}
