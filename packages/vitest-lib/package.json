{
  "name": "vitest-lib",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./chimeReporter": {
      "types": "./src/chimeReporter.ts",
      "import": "./src/chimeReporter.ts"
    },
    "./cliReporter": {
      "types": "./src/cliReporter.ts",
      "import": "./src/cliReporter.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:llm": "vitest run --reporter=vitest-llm-reporter"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "typescript": "~5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.18",
    "vitest-llm-reporter": "^1.2.2"
  }
}
