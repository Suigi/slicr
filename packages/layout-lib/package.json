{
  "name": "layout-lib",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "preview": "vite preview",
    "watch": "vitest --reporter=default --reporter=vitest-lib/cliReporter --reporter=src/vitest/statusCliReporter.ts",
    "test": "vitest run --reporter=vitest-llm-reporter",
    "test:llm": "vitest run --reporter=vitest-llm-reporter"
  },
  "dependencies": {
    "vitest-lib": "0.0.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.18",
    "vitest-llm-reporter": "^1.2.2"
  }
}
