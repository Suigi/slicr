{
  "name": "slicr-mono",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:llm": "npm run test:llm --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "./scripts/prettier-changed.sh write",
    "validate:llm": "./scripts/prettier-changed.sh check && npm run lint && npm run test:llm && npm run typecheck",
    "dev:frontend": "npm run dev --workspace slice-visualizer"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "prettier": "^3.9.4"
  }
}
